# VoiceAI Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# APPLICATION
# ============================================
APP_NAME=VoiceAI
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# ============================================
# DATABASE
# ============================================
POSTGRES_PASSWORD=replace-with-a-strong-random-password
DATABASE_URL=postgresql+asyncpg://postgres:replace-with-a-strong-random-password@localhost:5432/voiceai

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# CELERY
# ============================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ============================================
# SECURITY
# ============================================
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=your-encryption-key-change-in-production-32-chars

# ============================================
# CORS
# ============================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
CORS_ALLOW_CREDENTIALS=true

# ============================================
# TWILIO (Telephony - REQUIRED for calling)
# ============================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_APPLICATION_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WEBHOOK_BASE_URL=https://your-domain.com

# ============================================
# OPENAI (AI Logic Only - NOT for TTS)
# ============================================
# Used for: AI conversation logic, call analysis, summaries, entity extraction
# NOT used for TTS (we use FREE TTS engines instead)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

# ============================================
# FREE TTS ENGINE CONFIGURATION (NO COST!)
# ============================================
# Choose ONE engine: piper, coqui, espeak, system
#
# PIPER TTS (RECOMMENDED - Fast, High Quality, Many Voices)
# Install: pip install piper-tts
# Models auto-download on first use
FREE_TTS_ENGINE=piper
PIPER_PATH=piper

# COQUI TTS (High Quality, Multi-lingual, Voice Cloning)
# Install: pip install TTS torch torchaudio
# FREE_TTS_ENGINE=coqui
# COQUI_MODEL=tts_models/multilingual/multi-dataset/xtts_v2

# ESPEAK NG (Lightweight, Many Languages, Robotic)
# Install: apt-get install espeak-ng (Linux) / brew install espeak-ng (macOS)
# FREE_TTS_ENGINE=espeak

# SYSTEM TTS (Built-in OS TTS - macOS say, Windows SAPI, Linux festival/spd-say)
# FREE_TTS_ENGINE=system

# Cache directory for generated audio
FREE_TTS_CACHE_DIR=./storage/tts_cache

# ============================================
# GOOGLE (Sheets & Drive - Optional)
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.com/api/v1/integrations/google/callback

# ============================================
# N8N (Workflow Automation - Optional)
# ============================================
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook
N8N_API_KEY=your-n8n-api-key

# ============================================
# STORAGE
# ============================================
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./storage
STORAGE_MAX_FILE_SIZE=104857600

# ============================================
# CALLING DEFAULTS
# ============================================
DEFAULT_CALLING_WINDOW_START=09:00
DEFAULT_CALLING_WINDOW_END=18:00
DEFAULT_CALLING_TIMEZONE=Asia/Kolkata
DEFAULT_MAX_CALLS_PER_DAY=100
DEFAULT_DELAY_BETWEEN_CALLS=30
DEFAULT_MAX_RETRY_ATTEMPTS=3
DEFAULT_SKIP_WEEKENDS=true
MAX_CONCURRENT_CALLS=10

# ============================================
# CALLBACK DEFAULTS
# ============================================
DEFAULT_ALLOW_CALLBACKS=true
DEFAULT_CALLBACK_WINDOW_START=09:00
DEFAULT_CALLBACK_WINDOW_END=18:00
DEFAULT_MAX_CALLBACK_DAYS=7
CALLBACK_REMINDER_MINUTES=15

# ============================================
# GOOGLE SHEETS SYNC
# ============================================
SHEETS_SYNC_BATCH_SIZE=100
SHEETS_SYNC_RETRY_ATTEMPTS=3
SHEETS_SYNC_RETRY_DELAY=60

# ============================================
# MONITORING
# ============================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ============================================
# FRONTEND (Next.js)
# ============================================
NEXT_PUBLIC_API_URL=/api/v1
NEXTAUTH_SECRET=generate-a-random-secret-with-at-least-32-characters
NEXTAUTH_URL=http://localhost:3000  # Set to your public HTTPS URL in production